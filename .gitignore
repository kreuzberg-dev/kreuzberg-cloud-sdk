# Dart
.dart_tool/
.packages
pubspec.lock

# Generated client code (kept out of git; produced by `task generate`)
# NOTE: packages/dart/lib/src/_generated/ is intentionally NOT gitignored —
# pub.dev archives only include git-tracked files, so the generated tree must
# ship inside the package.
packages/python/src/xberg_io_sdk/_generated_api/
packages/python/src/xberg_io_sdk/_generated_pro/
packages/typescript/src/_generated/
packages/go/v1/generated_api.go
packages/go/v1/generated_pro.go
# Derived oapi-codegen config for the Pro schema set (written by
# tools/oapi-pro-config from oapi-codegen-pro.yaml + both specs).
packages/go/v1/oapi-codegen-pro.gen.yaml

